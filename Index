
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#26342b">
<meta name="description" content="هيئة تحرير باريس — القيادة العامة ومكتب التنظيم والانتساب">
<title>هيئة تحرير باريس | القيادة العامة</title>

<style>
:root {
  --green:#26342b;
  --green2:#34463a;
  --paper:#eeecdf;
  --paper2:#e3e0d2;
  --gold:#c6a45d;
  --red:#811d20;
  --ink:#263129;
  --muted:#6c7166;
  --border:#c5c1b1;
}
*{box-sizing:border-box}
body{
  margin:0;background:#d8d8ce;color:var(--ink);
  font-family:Tahoma,Arial,sans-serif;line-height:1.9
}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.site-header{
  background:var(--green);color:var(--paper);
  border-bottom:4px solid var(--gold)
}
.header-inner{
  max-width:1050px;margin:auto;padding:23px 20px 17px;
  display:flex;align-items:center;gap:20px
}
.header-mark{
  flex:0 0 74px;height:74px;border:1px solid var(--gold);
  display:grid;place-items:center;color:var(--gold)
}
.header-mark svg{width:57px;height:57px}
.header-text{flex:1}
.ministry{margin:0;font-size:13px;color:#d4c9a9;letter-spacing:.5px}
.site-title{font-size:clamp(21px,4vw,31px);font-weight:800;margin:0;line-height:1.55}
.department{margin:3px 0 0;font-size:13px;color:#c9cec2}
.header-code{
  align-self:flex-start;border:1px solid #69766a;
  padding:5px 10px;font-size:11px;color:#ded9c9;white-space:nowrap
}
.navbar{background:#1e2922;color:#e8e6d9;border-bottom:1px solid #526052}
.nav-inner{
  max-width:1050px;margin:auto;padding:8px 20px;
  display:flex;flex-wrap:wrap;gap:8px 22px;font-size:12px
}
.nav-item{color:#e8e6d9;text-decoration:none}
.nav-item:hover{color:#e4c783}
main{max-width:920px;margin:28px auto;padding:0 16px;min-height:420px}
.paper{
  background:var(--paper);border:1px solid #b8b4a5;
  box-shadow:0 7px 24px #242c2412;position:relative;
  padding:clamp(20px,5vw,46px)
}
.paper:before{
  content:"";position:absolute;inset:7px;
  border:1px solid #d0cbbb;pointer-events:none
}
.paper-content{position:relative;z-index:1}
.doc-meta{
  display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;
  border-bottom:1px solid var(--border);padding-bottom:14px;
  margin-bottom:26px;color:var(--muted);font-size:12px
}
.eyebrow{font-size:12px;color:#727466;letter-spacing:.3px;margin:0 0 6px}
h2{font-size:clamp(23px,4vw,31px);line-height:1.5;margin:0 0 14px;color:var(--green)}
h3{font-size:19px;margin:0 0 12px}
p{margin:0 0 17px}
.muted{color:var(--muted)}
.notice{
  border-right:3px solid var(--gold);padding:12px 16px;
  background:#e5e2d5;margin:22px 0;font-size:13px
}
.rule{border:0;border-top:1px solid var(--border);margin:25px 0}
.btn-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:25px}
.btn{
  border:1px solid var(--green);background:var(--green);color:#f2f0e4;
  padding:11px 22px;min-height:46px;transition:background .15s
}
.btn:hover{background:var(--green2)}
.btn-secondary{background:transparent;color:var(--green)}
.btn-secondary:hover{background:var(--paper2)}
.btn-red{background:var(--red);border-color:var(--red)}
.field{margin:20px 0}
.field label{display:block;font-size:14px;font-weight:bold;margin-bottom:7px}
input[type="text"],textarea,select{
  width:100%;background:#f7f5ec;border:1px solid #bcb9aa;
  color:var(--ink);padding:12px;border-radius:0;outline-offset:3px
}
textarea{min-height:110px;resize:vertical}
input:focus,textarea:focus,select:focus{outline:2px solid #9b844c}
.option-list{display:grid;gap:12px;margin:22px 0}
.option{
  display:flex;align-items:center;gap:12px;border:1px solid var(--border);
  padding:14px;background:#f4f2e8;cursor:pointer
}
.option:has(input:checked){border-color:var(--green);background:#e1e4d9}
.option input{accent-color:var(--green);width:17px;height:17px}
.progress-label{font-size:12px;color:var(--muted);margin-bottom:7px}
.progress-track{height:5px;background:#d3d0c2;margin-bottom:27px}
.progress-fill{height:100%;background:var(--green);transition:width .2s}
.result-box{border:1px solid #bdb9a9;background:#e5e2d5;padding:24px 20px;margin:22px 0}
.result-text{
  font-size:clamp(20px,4vw,26px);font-weight:bold;
  color:var(--green);line-height:1.9;margin:0
}
.final-note{border-top:1px solid var(--border);margin-top:30px;padding-top:20px;font-size:13px}
.site-footer{background:var(--green);color:var(--paper);border-top:4px solid var(--gold);margin-top:35px}
.footer-inner{
  max-width:1050px;margin:auto;padding:25px 20px;
  display:flex;align-items:flex-end;justify-content:space-between;gap:22px
}
.signature{max-width:330px;text-align:right;border-right:2px solid var(--gold);padding-right:14px}
.signature-role{color:#d0d2c5;font-size:12px;margin-bottom:3px}
.signature-name{color:#f0dfb2;font-size:18px;font-weight:bold}
.signature-caption{font-size:11px;color:#c4c8bb;margin-top:3px}
.footer-right{text-align:left;font-size:11px;color:#c4c8bb}
.seal{width:82px;display:block;margin-top:10px}
.seal svg{width:100%;height:auto}
.copyright{border-top:1px solid #566154;text-align:center;padding:11px 12px;font-size:11px;color:#c9cbbb}
.hidden{display:none!important}
@media(max-width:580px){
  .header-inner{gap:12px;padding:17px 14px}
  .header-mark{flex-basis:51px;height:57px}
  .header-mark svg{width:42px;height:42px}
  .header-code{display:none}
  .department,.ministry{font-size:11px}
  .nav-inner{padding:8px 14px;gap:6px 15px}
  main{margin:17px auto;padding:0 10px}
  .paper{padding:23px 17px}
  .footer-inner{padding:21px 15px}
  .signature-name{font-size:15px}
  .seal{width:65px}
  .footer-right{max-width:95px}
  .btn{width:100%}
}
</style>
</head>

