document.getElementById("submitAnswer").addEventListener("click", () => {
  const question = questions[currentQuestion];
  let result;

  if (question.type === "text") {
    const input = document.getElementById("answerText");
    if (!input || !input.value.trim()) {
      input.focus();
      input.setCustomValidity("يرجى إدخال إجابة قبل المتابعة.");
      input.reportValidity();
      input.addEventListener("input", () => input.setCustomValidity(""), {once:true});
      return;
    }
    result = question.result;
  } else {
    const selected = document.querySelector('input[name="answerChoice"]:checked');
    if (!selected) {
      alert("يرجى اختيار إحدى الإجابتين للمتابعة.");
      return;
    }
    result = question.results[selected.value];
  }

  resultText.textContent = result;
  resultSubtext.textContent = "تم تثبيت إجابة المرحلة الحالية.";
  const nextButton = document.getElementById("nextQuestion");
  nextButton.textContent = currentQuestion === questions.length - 1 ? "عرض النتيجة الختامية" : "السؤال التالي";
  showPage("resultPage");
});

document.getElementById("nextQuestion").addEventListener("click", () => {
  if (currentQuestion < questions.length - 1) {
    renderQuestion(currentQuestion + 1);
  } else {
    showPage("finalPage");
  }
});

