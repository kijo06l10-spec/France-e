<script>
"use strict";

const pages = document.querySelectorAll(".page");

function showPage(id) {
  pages.forEach(page => page.classList.toggle("hidden", page.id !== id));
  window.scrollTo({top:0,behavior:"auto"});
}

document.querySelectorAll("[data-go]").forEach(button => {
  button.addEventListener("click", () => showPage(button.dataset.go));
});

document.querySelectorAll("[data-home]").forEach(link => {
  link.addEventListener("click", event => {
    event.preventDefault();
    showPage("home");
  });
});

const questions = [
  {
    title:"ما هدفك من الانضمام إلى هيئة تحرير باريس؟",
    type:"text",
    result:"يا ساتر تء تء تء تء تء"
  },
  {
    title:"كم حجم الفائدة المادية للانتساب إلى هيئة تحرير باريس؟",
    type:"text",
    result:"والله انحطاط وفگر ونگر ما تستفيد شي"
  },
  {
    title:"هسه انت مقتنع بهل سالفه كلها؟!",
    type:"text",
    result:"والله شغله فاضيه انا اقلك"
  },
  {
    title:"عندك استعداد تضيع حياتك وأهدافك وطموحك على الفاضي مشان سالفه ماحد مقتنع بيها؟!",
    type:"choice",
    options:["إي","لأ"],
    results:{
      "إي":"دب مو بايدك",
      "لأ":"اي عفيه بكرى نزوجك"
    }
  },
  {
    title:"هل انت متأكد من أنك تريد الانضمام؟",
    type:"choice",
    options:["إي","لأ"],
    results:{
      "لأ":"لعد شقد فاضي شغال صارلك ساعه تگرك عندي",
      "إي":"روح روح تدور هيئات وانت ما عندك تاكل"
    }
  }
];

let currentQuestion = 0;

const questionTitle = document.getElementById("questionTitle");
const questionInput = document.getElementById("questionInput");
const questionNumber = document.getElementById("questionNumber");
const progressLabel = document.getElementById("progressLabel");
const progressFill = document.getElementById("progressFill");
const resultText = document.getElementById("resultText");
const resultSubtext = document.getElementById("resultSubtext");

function renderQuestion(index) {
  currentQuestion = index;
  const question = questions[index];

  questionTitle.textContent = question.title;
  questionNumber.textContent = "السؤال " + (index + 1);
  progressLabel.textContent = "المرحلة " + (index + 1) + " من " + questions.length;
  progressFill.style.width = ((index + 1) / questions.length * 100) + "%";
  questionInput.replaceChildren();

  if (question.type === "text") {
    const field = document.createElement("div");
    field.className = "field";

    const label = document.createElement("label");
    label.htmlFor = "answerText";
    label.textContent = "الإجابة";

    const input = document.createElement("textarea");
    input.id = "answerText";
    input.maxLength = 500;
    input.placeholder = "اكتب إجابتك هنا";
    input.setAttribute("aria-label", "الإجابة");

    field.append(label, input);
    questionInput.append(field);
  } else {
    const list = document.createElement("div");
    list.className = "option-list";

    question.options.forEach((option, i) => {
      const label = document.createElement("label");
      label.className = "option";

      const input = document.createElement("input");
      input.type = "radio";
      input.name = "answerChoice";
      input.value = option;
      input.id = "choice" + i;

